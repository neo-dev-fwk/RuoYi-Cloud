###############################################
#                 基础环境配置                 #
###############################################

# Docker Compose 项目名称，用于区分不同项目
COMPOSE_PROJECT_NAME=rouyi

# 设置容器时区为亚洲/上海
TZ=Asia/Shanghai

# 根路径（相对于当前项目）
# Docker_Data_PATH=.${Docker_Data_PATH}/env
Docker_Data_PATH=./tmp
# Docker_Cfg_PATH=/home/config/env
Docker_Cfg_PATH=./config

###############################################
#                 Redis 配置                  #
# 内存数据库                                  #
###############################################

# 容器镜像版本
REDIS_VERSION=7.4.2
# 服务端口(映射到宿主机)
REDIS_PORT=6379
# Redis 访问密码
REDIS_PASSWORD=redis1234
# 数据持久化存储路径
REDIS_DATA_PATH=${Docker_Data_PATH}/redis/data
# 日志文件存储路径
REDIS_LOGS_PATH=${Docker_Data_PATH}/redis/logs

# RedisInsight
REDIS_INSIGHT_PORT=18001
REDIS_INSIGHT_DATA_PATH=${Docker_Data_PATH}/redisinsight/data

###############################################
#                 MySQL 配置                  #
# 关系型数据库                                #
###############################################

# 容器镜像版本
MYSQL_VERSION=8.4.5
# 服务端口(映射到宿主机)
MYSQL_PORT=3306
# 初始化数据库
MYSQL_INITDB=ry-cloud
# root用户密码
MYSQL_ROOT_PASSWORD=mysql1234
# 数据存储路径
MYSQL_INIT_SCRIPT=${Docker_Cfg_PATH}/mysql/initscript
# 数据存储路径
MYSQL_DATA_PATH=${Docker_Data_PATH}/mysql/data
# 日志文件存储路径
MYSQL_LOGS_PATH=${Docker_Data_PATH}/mysql/log

# phpMyAdmin
PHPMYADMIN_PORT=14001

###############################################
#                 Nginx 配置                  #
# 内存数据库                                  #
###############################################
# Nginx 相关
NGINX_VERSION=1.24
NGINX_CONTAINER_NAME=my-nginx

# 端口映射
HOST_PORT=18080
CONTAINER_PORT=80
